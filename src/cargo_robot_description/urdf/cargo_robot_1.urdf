<?xml version="1.0"?>

<robot name="cargo_robot_1" xmlns:gz="http://gazebosim.org/schema">

  <!-- ========================= -->
  <!-- 로봇 본체 -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>

      <geometry>
        <box size="0.23 0.23 0.10"/>
      </geometry>

      <material name="blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>

      <geometry>
        <box size="0.23 0.23 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>

      <mass value="20.0"/>

      <inertia
        ixx="0.1048"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1048"
        iyz="0.0"
        izz="0.1763"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- 앞쪽 왼쪽 바퀴 -->
  <!-- ========================= -->

  <link name="front_left_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="front_left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="front_left_wheel"/>

    <origin xyz="0.075 0.145 0.03" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================= -->
  <!-- 앞쪽 오른쪽 바퀴 -->
  <!-- ========================= -->

  <link name="front_right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="front_right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="front_right_wheel"/>

    <origin xyz="0.075 -0.145 0.03" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================= -->
  <!-- 뒤쪽 왼쪽 바퀴 -->
  <!-- ========================= -->

  <link name="rear_left_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="rear_left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="rear_left_wheel"/>

    <origin xyz="-0.075 0.145 0.03" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================= -->
  <!-- 뒤쪽 오른쪽 바퀴 -->
  <!-- ========================= -->

  <link name="rear_right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>

      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>

  <joint name="rear_right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="rear_right_wheel"/>

    <origin xyz="-0.075 -0.145 0.03" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================= -->
  <!-- ROS 2 Control -->
  <!-- ========================= -->

  
  <!-- MECANUM FRICTION MODEL -->

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo와 ros2_control 연결 -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__CONTROLLER_CONFIG__</parameters>
      <ros>
        <namespace>/robot1</namespace>
      </ros>
    </plugin>
  </gazebo>

</robot>
