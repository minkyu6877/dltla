<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse_l_shape">
    <gravity>0 0 -9.8</gravity>
    <physics name="1ms" type="gz-physics-dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>2 1.5 8 0 0 0</pose><direction>-0.5 0.1 -1</direction></light>
    <!-- Coordinate convention: lower-left loading corner is (0, 0); map is 4 m x 3 m. -->
    <model name="floor"><static>true</static><pose>2 1.5 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 3 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 3 0.1</size></box></geometry><material><diffuse>0.82 0.82 0.82 1</diffuse></material></visual></link></model>

    <!-- Blue: robot standby. Yellow: loading. Green: selectable destination area. -->
    <model name="standby_zone"><static>true</static><pose>2.0 0.30 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.2 0.45 0.02</size></box></geometry><material><diffuse>0.1 0.35 0.95 0.85</diffuse></material></visual></link></model>
    <model name="loading_zone"><static>true</static><pose>0.40 0.35 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.60 0.60 0.02</size></box></geometry><material><diffuse>1 0.75 0.05 0.9</diffuse></material></visual></link></model>
    <model name="destination_zone"><static>true</static><pose>3.20 2.60 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.60 0.40 0.02</size></box></geometry><material><diffuse>0.15 0.8 0.25 0.85</diffuse></material></visual></link></model>

    <!-- Orange shelves: non-traversable blocks; the white aisles remain traversable. -->
    <model name="rack_vertical"><static>true</static><pose>1.20 1.55 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.50 1.70 0.90</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.50 1.70 0.90</size></box></geometry><material><diffuse>0.95 0.35 0.05 1</diffuse></material></visual></link></model>
    <model name="rack_upper"><static>true</static><pose>2.60 1.95 0.45 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.00 0.50 0.90</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.00 0.50 0.90</size></box></geometry><material><diffuse>0.95 0.35 0.05 1</diffuse></material></visual></link></model>
  </world>
</sdf>
