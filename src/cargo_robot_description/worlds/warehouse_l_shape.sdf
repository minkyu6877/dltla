<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse_l_shape">
    <gravity>0 0 -9.8</gravity>
    <physics name="1ms" type="gz-physics-dartsim">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>2 1.5 8 0 0 0</pose><direction>-0.5 0.1 -1</direction></light>
    <!-- Coordinate convention: lower-left corner is (0, 0); test map is 4 m x 3 m. -->
    <model name="floor"><static>true</static><pose>2 1.5 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 3 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 3 0.1</size></box></geometry><material><diffuse>0.82 0.82 0.82 1</diffuse></material></visual></link></model>

    <!-- Yellow: robot standby / return. Blue: cargo loading. Green: destination. -->
    <model name="standby_zone"><static>true</static><pose>0.72 0.425 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.10 0.55 0.02</size></box></geometry><material><diffuse>1 0.75 0.05 0.9</diffuse></material></visual></link></model>
    <model name="loading_zone"><static>true</static><pose>2.20 0.50 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.90 0.70 0.02</size></box></geometry><material><diffuse>0.1 0.35 0.95 0.85</diffuse></material></visual></link></model>
    <model name="destination_zone"><static>true</static><pose>3.55 2.55 0.011 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.50 0.40 0.02</size></box></geometry><material><diffuse>0.15 0.8 0.25 0.85</diffuse></material></visual></link></model>

  </world>
</sdf>
